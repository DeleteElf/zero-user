syntax = "v1"

info (
	title:   "website grpc demo"
	desc:    "website grpc demo desc"
	author:  "DeleteElf"
	email:   "deleteelf@gmail.com"
	version: "1.0"
)

type IdRequest {
	Id string `path:"id"` //IdRequest生成后，需要从types.go里删除，我们全局只需要一个，引用base.
}

type Response {
	Code    string `json:"code"` //Response生成后，需要从types.go里删除，我们全局只需要一个，引用base.
	Message string `json:"message,optional"` //设置应答的格式
	Result  string `json:"result,optional"`  //生成时，是不支持any类型的
}

@server (
	prefix:     /char //用来增加一级目录
	middleware: AuthInterceptor
	group:      character
	timeout:    2s
)
service character-api {
	@doc "获取角色信息"
	@handler RoleInfoHandler
	get /role/info/:id (IdRequest) returns (Response)

    @doc "获取权限信息"
    @handler AuthInfoHandler
    get /auth/info/:id (IdRequest) returns (Response)
}

