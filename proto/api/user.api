syntax = "v1"

info (
	title:   "website grpc demo"
	desc:    "website grpc demo desc"
	author:  "DeleteElf"
	email:   "deleteelf@gmail.com"
	version: "1.0"
)

type IdRequest {
	Id string `path:"id"` //IdRequest生成后，需要从types.go里删除，我们全局只需要一个，引用base.
}

type LoginRequest {
	Account  string `json:"account,optional" form:"account,optional"` //设置请求的格式要求,如果需要使用用户名或邮箱，也通过此字段传输
	Password string `json:"pwd,optional" form:"pwd,optional"` //因为支持两种格式，因此两种都要设置optional，后续在handler内校验非空，如果不这么做，则必须分开设置两个type，这里仅作为教学
	Type     int    `json:"t,optional,default=0" form:"t"` //0 表示account 1表示username 2表示email
}

type ChangePwdRequest {
	OldPwd string `json:"oldPwd,optional" form:"oldPwd,optional"` //旧密码
	NewPwd string `json:"newPwd,optional" form:"newPwd,optional"` //新密码
	RePwd  string `json:"rePwd,optional" form:"rePwd,optional"` //重复新密码
}

type Response {
	Code    string `json:"code"` //Response生成后，需要从types.go里删除，我们全局只需要一个，引用base.
	Message string `json:"message,optional"` //设置应答的格式
	Result  string `json:"result,optional"`
}

@server (
	//       prefix:  /user //用来增加一级目录
	group:   user //用来生成分组目录
	timeout: 2s
)
//定义好api后，使用 goctl api go -api user.api -dir . 自动生成代码
service user-api {
	@doc "登录"
	@handler LoginHandler
	post /login (LoginRequest) returns (Response)
}

@server (
	prefix:     /user
	middleware: AuthInterceptor
	group:      user //用来生成分组目录
	timeout:    2s
)
//定义好api后，使用 goctl api go -api user.api -dir . 自动生成代码
service user-api {
	@doc "登出"
	@handler LogoutHandler
	get /logout returns (Response)

	@doc "获取用户信息"
	@handler UserInfoHandler
	get /info/:id (IdRequest) returns (Response)

	@doc "修改用户密码"
	@handler ChangePwdHandler
	post /changePwd (ChangePwdRequest) returns (Response)
}

